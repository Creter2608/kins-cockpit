{
  "name": "kins-cockpit",
  "version": "3.1.0",
  "description": "Desktop mission-control cockpit for autonomous AI pair programming",
  "productName": "Kin's Cockpit",
  "private": true,
  "type": "module",
  "main": "dist/src/main/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs && node scripts/setup-mcp.mjs",
    "setup:mcp": "node scripts/setup-mcp.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:preload": "node -e \"require('esbuild').buildSync({ entryPoints: ['src/preload/index.ts'], outfile: 'dist/src/preload/index.cjs', format: 'cjs', platform: 'node', external: ['electron'], bundle: true })\"",
    "build:node": "node node_modules/typescript/bin/tsc -p tsconfig.json && npm run build:preload",
    "build:ui": "node node_modules/vite/bin/vite.js build",
    "build": "npm run clean && npm run build:node && npm run build:ui",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "npm run build:node && node --test --test-concurrency=1 dist/test/*.test.js",
    "test:ai": "node scripts/ai-exec.mjs npm test",
    "typecheck:ai": "node scripts/ai-exec.mjs npm run typecheck",
    "preflight": "node scripts/preflight.mjs",
    "app:dev": "node node_modules/vite/bin/vite.js",
    "app:start": "node node_modules/electron/cli.js dist/src/main/index.js",
    "pack:prepare": "node scripts/bundle-all.mjs && npm run build",
    "package": "npm run build && npx electron-builder --dir",
    "pack": "npm run build && npx electron-builder --dir",
    "dist": "npm run build && npx electron-builder",
    "dist:portable": "npm run build && npx electron-builder --win portable",
    "build:docker": "docker exec kins_autonomous_sandbox npm run build",
    "loop": "node scripts/ai-loop.mjs",
    "loop:mcp": "node dist/src/loop/mcp-server.js",
    "scaffold:new": "node scripts/init-template.mjs",
    "template:init": "node scripts/init-template.mjs",
    "shortcut": "powershell -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "test:docker": "docker run --rm -v \".:/workspace\" -w /workspace node:22-bookworm-slim npm test",
    "typecheck:docker": "docker run --rm -v \".:/workspace\" -w /workspace node:22-bookworm-slim npm run typecheck",
    "sandbox:sh": "docker run --rm -it -v \".:/workspace\" -w /workspace node:22-bookworm-slim /bin/sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^1.16.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.3.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kins.cockpit",
    "productName": "Kin's Cockpit",
    "npmRebuild": false,
    "copyright": "Copyright © 2026 Kin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bundled",
        "to": "bundled",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**/*",
      "dist/src/cli/**/*",
      "dist/src/main/services/**/*",
      "dist/src/shared/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Kin's Cockpit",
      "include": "scripts/installer/prerequisites.nsh"
    }
  }
}
